{
  "name": "@aquascheme/engine",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./terrain": {
      "types": "./src/terrain.ts",
      "default": "./src/terrain.ts"
    },
    "./hydraulics": {
      "types": "./src/hydraulics.ts",
      "default": "./src/hydraulics.ts"
    },
    "./sizing": {
      "types": "./src/sizing.ts",
      "default": "./src/sizing.ts"
    },
    "./dxf": {
      "types": "./src/dxf.ts",
      "default": "./src/dxf.ts"
    },
    "./dxfread": {
      "types": "./src/dxfread.ts",
      "default": "./src/dxfread.ts"
    },
    "./constrained-route": {
      "types": "./src/constrained-route.ts",
      "default": "./src/constrained-route.ts"
    },
    "./reconstruction-from-survey": {
      "types": "./src/reconstruction-from-survey.ts",
      "default": "./src/reconstruction-from-survey.ts"
    }
  },
  "scripts": {
    "test": "vitest run --pool=threads --poolOptions.threads.singleThread",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tarikjabiri/dxf": "^2.8.9",
    "@turf/turf": "^7.2.0",
    "dxf-parser": "^1.1.2",
    "epanet-js": "^0.9.0"
  },
  "devDependencies": {
    "typescript": "~5.8.0",
    "vitest": "^3.2.0"
  }
}
